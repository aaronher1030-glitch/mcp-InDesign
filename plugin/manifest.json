{
  "manifestVersion": 5,
  "id": "com.ads.indesign-bridge",
  "name": "InDesign Copilot",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "InDesign Copilot" },
      "minimumSize": { "width": 280, "height": 420 },
      "maximumSize": { "width": 800, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 640 },
      "preferredFloatingSize": { "width": 360, "height": 720 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "allowCodeGenerationFromStrings": true
  }
}
